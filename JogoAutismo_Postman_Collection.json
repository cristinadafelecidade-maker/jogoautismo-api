{
  "info": {
    "name": "Jogo Autismo API",
    "description": "Colecção completa de testes para o Sistema Educativo Inclusivo para crianças com autismo.\n\n**COMO USAR:**\n1. Primeiro faça login em POST /api/auth/login\n2. Copie o 'token' da resposta\n3. Nas outras requests, o token é preenchido automaticamente via variável {{token}}\n\n**Credenciais de Teste:**\n- ADMIN: admin@jogoautismo.mz / admin123\n- EDUCADOR: fatima@escola.mz / admin123\n- ENCARREGADO: maria@gmail.com / admin123\n- ALUNO: nilton@aluno.mz / admin123",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login como ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.test('Login bem-sucedido', () => pm.response.to.have.status(200));",
                  "pm.test('Token recebido', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jogoautismo.mz\",\n  \"senha\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Login como EDUCADOR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.test('Login EDUCADOR OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"fatima@escola.mz\",\n  \"senha\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Login como ENCARREGADO",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@gmail.com\",\n  \"senha\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Login como ALUNO",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nilton@aluno.mz\",\n  \"senha\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Login com credenciais erradas (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Deve retornar 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jogoautismo.mz\",\n  \"senha\": \"senhaerrada\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Encarregados",
      "item": [
        {
          "name": "Listar todos os encarregados",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('É um array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/encarregados"
          }
        },
        {
          "name": "Cadastrar novo encarregado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('encarregadoId', json.id);",
                  "pm.test('Nome correcto', () => pm.expect(json.nome).to.eql('Teste Encarregado'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/encarregados",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teste Encarregado\",\n  \"email\": \"teste.enc@gmail.com\",\n  \"celular\": \"847777777\",\n  \"parentesco\": \"Mãe\"\n}"
            }
          }
        },
        {
          "name": "Buscar encarregado por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/encarregados/1"
          }
        },
        {
          "name": "Pesquisar encarregado por nome",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/encarregados/buscar?nome=Maria",
              "query": [{ "key": "nome", "value": "Maria" }]
            }
          }
        },
        {
          "name": "Actualizar encarregado",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/encarregados/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria João Sitoe Actualizada\",\n  \"email\": \"maria.actualizada@gmail.com\",\n  \"celular\": \"844444444\",\n  \"parentesco\": \"Mãe\"\n}"
            }
          }
        },
        {
          "name": "Remover encarregado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/encarregados/{{encarregadoId}}"
          }
        }
      ]
    },
